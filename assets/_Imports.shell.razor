@* BlueprintShell starter imports - shipped via contentFiles.
   This file is named _Imports.shell.razor so it does NOT clobber your own
   _Imports.razor on package install. Only files literally named
   _Imports.razor are picked up by Razor as folder-level imports, so you have
   two adoption paths:

     1) Rename a project-local copy of this file to _Imports.razor, OR
     2) Append the @using directives below into your existing _Imports.razor.

   Note: BbPortalHost (required for dialogs / popovers / toasts) lives in
   BlazorBlueprint.Primitives.Services, NOT BlazorBlueprint.Primitives. *@

@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@using BlueprintShell
@using BlueprintShell.Shared
@using BlueprintShell.Shell

@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Primitives.Services
@using BlazorBlueprint.Icons.Lucide.Components
@using BlazorBlueprint.Icons.Feather.Components
@using BlazorBlueprint.Icons.Heroicons.Components
