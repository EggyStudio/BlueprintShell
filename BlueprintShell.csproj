<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>BlueprintShell</RootNamespace>
        <AssemblyName>BlueprintShell</AssemblyName>
    </PropertyGroup>

    <!-- NuGet package metadata -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>BlueprintShell</PackageId>
        <Version>0.1.6</Version>
        <Description>Embeddable editor shell built on BlazorBlueprint. Spin up a themed, dockable editor UI on a configurable port from any .NET application.</Description>
        <Authors>EggyStudio</Authors>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/EggyStudio/BlueprintShell</RepositoryUrl>
        <PackageProjectUrl>https://github.com/EggyStudio/BlueprintShell</PackageProjectUrl>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageTags>blazor;blueprintshell;editor;shell;blazorblueprint</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <!-- Branding / docs -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
        <None Include=".github/assets/*" Pack="true" PackagePath="/" Visible="true"/>
    </ItemGroup>

    <!-- Drop-in _Imports.shell.razor surfaced via contentFiles for consumers.
         Named .shell.razor so it does NOT shadow the consumer's own _Imports.razor.
         Modern PackageReference consumers receive it as a linked content file in
         Solution Explorer; they rename it to _Imports.razor or copy its @using
         lines into an existing one. Source lives in assets/ to keep it out of the
         Razor SDK's implicit .razor glob, then we manually pack it. -->
    <ItemGroup>
        <Content Remove="assets/_Imports.shell.razor" />
        <None Remove="assets/_Imports.shell.razor" />
        <None Include="assets/_Imports.shell.razor"
              Pack="true"
              PackagePath="contentFiles/any/any/_Imports.shell.razor;content/_Imports.shell.razor"
              BuildAction="None"
              CopyToOutput="false"
              Flatten="false" />
    </ItemGroup>

    <!-- Surface GitHub Actions workflows in the IDE solution view. 
         Not packed, not copied to output. -->
    <ItemGroup>
        <None Include=".github/workflows/*.yml" Pack="false" Visible="true"/>
        <None Include=".github/workflows/*.yaml" Pack="false" Visible="true"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ASP.NET Core - consumed from the hosting runtime, not bundled into the library -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BlazorBlueprint.Components" Version="3.10.0" />
        <PackageReference Include="BlazorBlueprint.Icons.Feather" Version="2.0.0" />
        <PackageReference Include="BlazorBlueprint.Icons.Heroicons" Version="2.0.0" />
        <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.*" />
        <PackageReference Include="BlazorBlueprint.Primitives" Version="3.10.0" />
    </ItemGroup>

</Project>