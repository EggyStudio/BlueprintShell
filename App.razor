@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Web
@inject BlueprintShellOptions Options

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <title>@Options.AppTitle</title>
    <!-- Theme CSS variables (OKLCH colour space) - must load first -->
    <link href="styles/themes/default.css" rel="stylesheet"/>
    <!-- BlazorBlueprint component styles -->
    <link href="_content/BlazorBlueprint.Components/blazorblueprint.css" rel="stylesheet"/>
    <!-- App Tailwind utilities -->
    <link href="css/app.css" rel="stylesheet"/>
    <HeadOutlet/>
</head>
<body class="font-sans antialiased">

<Routes @rendermode="InteractiveServer"/>

<div id="blazor-error-ui"
     class="hidden fixed bottom-0 left-0 right-0 z-50 p-4 bg-destructive text-destructive-foreground text-sm">
    An unhandled error has occurred.
    <a href="" class="underline font-medium">Reload</a>
</div>

<!-- Floating UI for positioning (Select, Popover, Tooltip, etc.) -->
<script type="module">
    import * as FloatingUI from 'https://cdn.jsdelivr.net/npm/@@floating-ui/dom@@1.5.3/+esm';
    window.FloatingUIDOM = FloatingUI;
</script>

<script src="_framework/blazor.web.js"></script>
<script>
    window.toggleDarkMode   = () => document.documentElement.classList.toggle('dark');
    window.isDarkModeEnabled = () => document.documentElement.classList.contains('dark');
</script>
</body>
</html>
