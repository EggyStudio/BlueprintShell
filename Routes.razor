@using BlueprintShell.Shell
@using BlueprintShell.Shared
@using BlueprintShell.Shared.Layouts
@inject ShellRegistry Registry

<Router AppAssembly="@typeof(ShellServerHost).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@LayoutFor(routeData)"/>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(ShellLayout)">
            <div class="flex flex-col items-center justify-center min-h-[400px] gap-4">
                <h1 class="text-4xl font-bold">404</h1>
                <p class="text-muted-foreground">Sorry, there's nothing at this address.</p>
                <a href="/" class="text-primary underline">Go home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private Type LayoutFor(RouteData routeData)
    {
        // If the catch-all Index.razor resolved a reader-page, use that page's preferred layout.
        if (routeData.PageType == typeof(BlueprintShell.Pages.Index)
            && routeData.RouteValues.TryGetValue("Slug", out var slugObj))
        {
            var route = string.IsNullOrEmpty(slugObj as string) ? "/" : "/" + slugObj;
            var reader = Registry.Current.ReaderPages
                .FirstOrDefault(r => !r.UseBlazorRouter && RouteMatcher.Match(r.Route, route, out _));
            if (reader is not null)
            {
                if (reader.Layout is not null) return reader.Layout;
                return reader.Chrome switch
                {
                    ShellChromeMode.Hidden => typeof(ReaderLayout),
                    ShellChromeMode.Minimal => typeof(MinimalLayout),
                    _ => typeof(ShellLayout),
                };
            }
        }

        return typeof(ShellLayout);
    }
}
